# Supabase project URL and publishable key (never put a service role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, required for creating bookings and running the disposable race test.
# Never expose this key with a NEXT_PUBLIC_ prefix or commit its value.
SUPABASE_SECRET_KEY=

# Server only. Keep OpenAI keys out of NEXT_PUBLIC_* variables.
OPENAI_API_KEY=

# n8n webhook secret, configured only after a private instance is approved
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
